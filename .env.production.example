# Copy to .env.production; never commit the populated file.
# Always use: docker compose --env-file .env.production -f compose.production.yaml ...
APP_NAME="SHOPGAME ZUTO"
APP_ENV=production
APP_DEBUG=false
APP_URL=https://your-domain.example
# Generate once with the Docker command shown during deployment; preserve on redeploy.
APP_KEY=
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

HTTP_PORT=8080
# Trust the immediate proxy only. Keep the backend loopback-only and configure
# your HTTPS reverse proxy to overwrite X-Forwarded-For and X-Forwarded-Proto.
TRUSTED_PROXIES=REMOTE_ADDR

DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=game_market
DB_USERNAME=game_market
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
CACHE_STORE=database
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local

LOG_CHANNEL=stderr
LOG_LEVEL=warning
MAIL_MAILER=log
MAIL_FROM_ADDRESS="hello@your-domain.example"
MAIL_FROM_NAME="${APP_NAME}"
